# atc-app does not read .env files for app config.
# App values (Supabase, RevenueCat, AdMob, debug flags) live as plain strings in
#   packages/app/src/config/env.ts
# Capacitor AdMob app ids live in packages/mobile/capacitor.config.ts.
#
# Only build/CI tooling still reads the environment:
#   CAPACITOR_PLATFORM   set by the build:mobile:* scripts
#   VITE_DEV_SERVER_URL  set by the electron dev script
#   ANDROID_HOME         checked by scripts/verify-env.js
