# Copy the files below and replace every `mocked_<VAR NAME>` value with the real one.
# All .env files are gitignored; code falls back to `mocked_<VAR NAME>` when a var is unset.
#
#   .env                          root tooling (Android signing, Apple API, RevenueCat webhook)
#   .env.revenuecat               RevenueCat webhook secret
#   .env.supabase                 Supabase project (server side)
#   packages/app/.env.local       Vite app vars (VITE_*) + AdMob app ids for Capacitor
#   packages/mobile/.env.local    AdMob ids
#   packages/electron/.env.local  Electron main process (Supabase URL + service-role key)
#
# Root .env
VITE_API_URL=mocked_VITE_API_URL

ANDROID_KEY_ALIAS=mocked_ANDROID_KEY_ALIAS
ANDROID_KEY_PASSWORD=mocked_ANDROID_KEY_PASSWORD
ANDROID_KEYSTORE_PASSWORD=mocked_ANDROID_KEYSTORE_PASSWORD
ANDROID_KEYSTORE_BASE64=mocked_ANDROID_KEYSTORE_BASE64

ADMOB_APP_ID_ANDROID=mocked_ADMOB_APP_ID_ANDROID
VITE_RC_IOS_KEY=mocked_VITE_RC_IOS_KEY
VITE_RC_ANDROID_KEY=mocked_VITE_RC_ANDROID_KEY

APPLE_API_ISSUER=mocked_APPLE_API_ISSUER
APPLE_API_KEY=mocked_APPLE_API_KEY
APPLE_API_KEY_ID=mocked_APPLE_API_KEY_ID
REVENUECAT_WEBHOOK_SECRET=mocked_REVENUECAT_WEBHOOK_SECRET
